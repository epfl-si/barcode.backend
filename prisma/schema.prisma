// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../generated/pothos-prisma-types.ts"
}

datasource db {
  provider = "mysql"
}

model Inventory {
  id_storage Int    @id @default(autoincrement())
  barcode    String @unique(map: "barcode") @db.VarChar(80)

  @@map("inventory")
}

model mutation_logs {
  id_mutation_logs Int      @id @default(autoincrement())
  modified_by      String
  modified_on      DateTime @default(now())
  table_name       String
  table_id         Int
  column_name      String
  old_value        String   @db.LongText
  new_value        String   @db.LongText
  action           String
}

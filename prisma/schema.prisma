// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../generated/pothos-prisma-types.ts"
}

datasource db {
  provider = "postgresql"
}

model RoomType {
  idRoomType   Int    @id @default(autoincrement()) @map("id_room_type")
  roomTypeName String @unique @map("room_type_name") @db.VarChar(64)

  storages         Storage[]
  allowedTypeValue AllowedTypeValue[]

  @@map("room_type")
}

model ProductType {
  idProductType   Int    @id @default(autoincrement()) @map("id_product_type")
  productTypeName String @unique @map("product_type_name") @db.VarChar(64)

  storages         Storage[]
  allowedTypeValue AllowedTypeValue[]

  @@map("product_type")
}

model StorageType {
  idStorageType   Int    @id @default(autoincrement()) @map("id_storage_type")
  storageTypeName String @unique @map("storage_type_name") @db.VarChar(64)

  allowedTypeValue AllowedTypeValue[]
  storages         Storage[]

  @@map("storage_type")
}

model StorageSubType {
  idStorageSubType   Int    @id @default(autoincrement()) @map("id_storage_subtype")
  storageSubTypeName String @unique @map("storage_subtype_name") @db.VarChar(64)

  allowedTypeValue AllowedTypeValue[]
  storages         Storage[]

  @@map("storage_subtype")
}

model AllowedTypeValue {
  idRoomType       Int     @map("id_room_type")
  idProductType    Int     @map("id_product_type")
  idStorageType    Int     @map("id_storage_type")
  idStorageSubType Int     @map("id_storage_subtype")
  allowsShelves    Boolean @default(true) @map("allows_shelves")
  allowsBoxes      Boolean @default(true) @map("allows_boxes")

  roomType       RoomType       @relation(fields: [idRoomType], references: [idRoomType])
  productType    ProductType    @relation(fields: [idProductType], references: [idProductType])
  storageType    StorageType    @relation(fields: [idStorageType], references: [idStorageType])
  storageSubType StorageSubType @relation(fields: [idStorageSubType], references: [idStorageSubType])

  @@id([idRoomType, idProductType, idStorageType, idStorageSubType])
  @@map("allowed_type_values")
}

model Storage {
  idStorage        Int       @id @default(autoincrement()) @map("id_storage")
  barcode          String    @unique @map("barcode") @db.VarChar(64)
  labDisplay       String    @map("lab_display") @db.VarChar(32)
  idRoomType       Int       @map("id_room_type")
  idProductType    Int       @map("id_product_type")
  idStorageType    Int       @map("id_storage_type")
  idStorageSubType Int       @map("id_storage_subtype")
  createdBy        String    @map("created_by")
  createdOn        DateTime  @default(now()) @map("created_on")
  deletedBy        String?   @map("deleted_by")
  deletedOn        DateTime? @map("deleted_on")

  roomType       RoomType       @relation(fields: [idRoomType], references: [idRoomType])
  productType    ProductType    @relation(fields: [idProductType], references: [idProductType])
  storageType    StorageType    @relation(fields: [idStorageType], references: [idStorageType])
  storageSubType StorageSubType @relation(fields: [idStorageSubType], references: [idStorageSubType])
  shelves        Shelf[]

  @@map("storages")
}

model Shelf {
  idShelf   Int       @id @default(autoincrement()) @map("id_shelf")
  barcode   String    @unique @map("barcode") @db.VarChar(64)
  idStorage Int       @map("id_storage")
  createdBy String    @map("created_by")
  createdOn DateTime  @default(now()) @map("created_on")
  deletedBy String?   @map("deleted_by")
  deletedOn DateTime? @map("deleted_on")

  storage Storage @relation(fields: [idStorage], references: [idStorage])
  box     Box[]

  @@map("shelves")
}

model Box {
  idBox     Int       @id @default(autoincrement()) @map("id_box")
  barcode   String    @unique @map("barcode") @db.VarChar(64)
  idShelf   Int       @map("id_shelf")
  createdBy String    @map("created_by")
  createdOn DateTime  @default(now()) @map("created_on")
  deletedBy String?   @map("deleted_by")
  deletedOn DateTime? @map("deleted_on")

  shelf Shelf @relation(fields: [idShelf], references: [idShelf])

  @@map("boxes")
}

model MutationLog {
  idMutationLog Int      @id @default(autoincrement()) @map("id_mutation_log")
  modifiedBy    String   @map("modified_by")
  modifiedOn    DateTime @default(now()) @map("modified_on")
  tableName     String   @map("table_name") @db.VarChar(32)
  tableId       Int      @map("table_id")
  columnName    String?  @map("column_name") @db.VarChar(32)
  oldValue      String   @map("old_value")
  newValue      String   @map("new_value")
  action        String   @map("action") @db.VarChar(32)

  @@map("mutation_log")
}
